#!/bin/sh
# Usage: bin/bump X.Y.Z
# Downloads the release DMG for that version, computes its sha256 and rewrites
# `version` and `sha256` in Casks/grantpin.rb, then prints the diff.
set -eu

if [ $# -ne 1 ]; then
  echo "usage: bin/bump X.Y.Z" >&2
  exit 2
fi
version=$1
case $version in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "bump: '$version' is not a version like 0.2.1" >&2; exit 2 ;;
esac
case $version in
  *[!0-9.]*) echo "bump: '$version' is not a version like 0.2.1" >&2; exit 2 ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
cask=$root/Casks/grantpin.rb
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

gh release download "v$version" -R jmeh-sindikata/grantpin -p "grantpin-$version.dmg" -D "$tmp"
sha=$(shasum -a 256 "$tmp/grantpin-$version.dmg" | awk '{print $1}')
echo "grantpin-$version.dmg sha256 $sha"

sed -e "s/^  version \".*\"$/  version \"$version\"/" \
    -e "s/^  sha256 \".*\"$/  sha256 \"$sha\"/" "$cask" > "$tmp/grantpin.rb"
cat "$tmp/grantpin.rb" > "$cask"

git -C "$root" --no-pager diff --stat -- Casks/grantpin.rb
git -C "$root" --no-pager diff -- Casks/grantpin.rb
if git -C "$root" diff --quiet -- Casks/grantpin.rb; then
  echo "no changes: the cask is already at $version"
fi
